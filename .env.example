# MapMyTrain Root Configuration
# Copy this file to .env and modify values as needed

# ──────────────────────────────────────────────
# Database (PostgreSQL + PostGIS)
# ──────────────────────────────────────────────
DB_PASSWORD=changeme
POSTGRES_USER=mmt_user
POSTGRES_DB=mapmytrain
DB_PORT=5432

# ──────────────────────────────────────────────
# Redis (Cache + Pub/Sub + Rate Limiting)
# ──────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
BACKEND_PORT=8000
INGESTION_INTERVAL_SECONDS=120
DEVELOPMENT_MOCK_MODE=true

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_USE_MOCK_TELEMETRY=true

# ──────────────────────────────────────────────
# Tile Server
# ──────────────────────────────────────────────
TILESERVER_PORT=8080
