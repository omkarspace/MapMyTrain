# MapMyTrain Backend Configuration
# Copy this file to .env and modify values as needed

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
PROJECT_NAME=MapMyTrain Core
VERSION=1.0.0
API_V1_STR=/api/v1

# ──────────────────────────────────────────────
# Database (PostgreSQL + PostGIS)
# ──────────────────────────────────────────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mmt_user:secure_spatial_pwd@localhost:5432/mapmytrain_dev

# ──────────────────────────────────────────────
# Redis (Cache + Pub/Sub + Rate Limiting)
# ──────────────────────────────────────────────
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://redis_secure_token@localhost:6379/0

# ──────────────────────────────────────────────
# Operational Flags
# ──────────────────────────────────────────────
# Set to true to use mock data instead of scraping NTES
DEVELOPMENT_MOCK_MODE=true

# Ingestion interval in seconds (default: 120)
INGESTION_INTERVAL_SECONDS=120

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable JSON structured logging
LOG_JSON=true

# ──────────────────────────────────────────────
# Monitoring (optional)
# ──────────────────────────────────────────────
# Prometheus metrics endpoint port (0 to disable)
METRICS_PORT=9090

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ──────────────────────────────────────────────
# Scraper Configuration
# ──────────────────────────────────────────────
# Request timeout in seconds
SCRAPER_TIMEOUT=10

# Max concurrent scraper requests
SCRAPER_CONCURRENCY=5

# Retry attempts for failed scrapes
SCRAPER_MAX_RETRIES=3

# Base backoff seconds for exponential backoff
SCRAPER_BASE_BACKOFF=30

# Max backoff seconds
SCRAPER_MAX_BACKOFF=600